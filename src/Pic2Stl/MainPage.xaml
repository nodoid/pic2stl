<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:pv="clr-namespace:Plugin.ProgressViews;assembly=Plugin.ProgressViews"
             xmlns:controls="clr-namespace:Pic2Stl.Controls"
             x:Class="Pic2Stl.MainPage"
             Title="Pic2Stl"
             BackgroundColor="#0B0F1A">

    <Grid>
        <!-- Everything above the 3D view scrolls, so the controls still fit on a small screen while the
             viewer keeps its own space and its drag gestures are never stolen by a scroll view. -->
        <Grid RowDefinitions="*,Auto,Auto,Auto"
              RowSpacing="10"
              Padding="16,10,16,14">

          <ScrollView x:Name="MainScroll" Grid.Row="0" VerticalScrollBarVisibility="Never">
            <VerticalStackLayout Spacing="10">

            <!-- Title -->
            <VerticalStackLayout Spacing="2">
                <Label Text="Pic2Stl"
                       FontSize="28"
                       FontAttributes="Bold"
                       TextColor="#EEF2FF" />
                <Label Text="Photo in, printable 3D model out"
                       FontSize="13"
                       TextColor="#8C97B5" />
            </VerticalStackLayout>

            <!-- Photo selection -->
            <Border
                    BackgroundColor="#161C2C"
                    Stroke="#242C42"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 16"
                    Padding="12">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                    <Border WidthRequest="84"
                            HeightRequest="84"
                            BackgroundColor="#0E1220"
                            Stroke="#242C42"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 12">
                        <Image x:Name="PhotoPreview"
                               Aspect="AspectFill" />
                    </Border>

                    <VerticalStackLayout Grid.Column="1" Spacing="8" VerticalOptions="Center">
                        <Button x:Name="CaptureButton"
                                Text="Take a picture"
                                Clicked="OnCaptureClicked"
                                BackgroundColor="#6C8CFF"
                                TextColor="#0B0F1A"
                                FontAttributes="Bold"
                                CornerRadius="12"
                                HeightRequest="44" />
                        <Button x:Name="PickButton"
                                Text="Use a photo from the device"
                                Clicked="OnPickClicked"
                                BackgroundColor="#2A3350"
                                TextColor="#DCE4FF"
                                CornerRadius="12"
                                HeightRequest="44" />
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <!-- Crop and object selection, only once there is a photo -->
            <Grid x:Name="EditBar"
                  ColumnDefinitions="*,*,Auto"
                  ColumnSpacing="8"
                  IsVisible="False">
                <Button x:Name="CropButton"
                        Text="Crop"
                        Clicked="OnCropClicked"
                        BackgroundColor="#2A3350"
                        TextColor="#DCE4FF"
                        CornerRadius="10"
                        HeightRequest="38"
                        FontSize="13" />
                <Button x:Name="SelectObjectButton"
                        Grid.Column="1"
                        Text="Select object"
                        Clicked="OnSelectObjectClicked"
                        BackgroundColor="#2A3350"
                        TextColor="#DCE4FF"
                        CornerRadius="10"
                        HeightRequest="38"
                        FontSize="13" />
                <Button x:Name="UndoButton"
                        Grid.Column="2"
                        Text="Undo"
                        Clicked="OnUndoClicked"
                        BackgroundColor="#1B2234"
                        TextColor="#8C97B5"
                        CornerRadius="10"
                        HeightRequest="38"
                        FontSize="13"
                        IsVisible="False" />
            </Grid>

            <!-- Settings, generate and progress -->
            <VerticalStackLayout Spacing="8">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                    <Label Text="Width"
                           TextColor="#8C97B5"
                           FontSize="13"
                           VerticalOptions="Center" />
                    <Slider x:Name="WidthSlider"
                            Grid.Column="1"
                            Minimum="30"
                            Maximum="150"
                            Value="80"
                            MaximumTrackColor="#2A3350"
                            MinimumTrackColor="#6C8CFF"
                            ThumbColor="#EEF2FF"
                            ValueChanged="OnWidthChanged" />
                    <Label x:Name="WidthLabel"
                           Grid.Column="2"
                           Text="80 mm"
                           TextColor="#DCE4FF"
                           FontSize="13"
                           WidthRequest="56"
                           HorizontalTextAlignment="End"
                           VerticalOptions="Center" />
                </Grid>

                <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8">
                    <VerticalStackLayout Spacing="0" VerticalOptions="Center">
                        <Label Text="Print colours"
                               TextColor="#DCE4FF"
                               FontSize="14" />
                        <Label Text="Spools the photo is mapped onto."
                               TextColor="#8C97B5"
                               FontSize="11" />
                    </VerticalStackLayout>
                    <Button x:Name="ColourCountDown"
                            Grid.Column="1"
                            Text="−"
                            Clicked="OnFewerColours"
                            IsEnabled="False"
                            BackgroundColor="#1B2234"
                            TextColor="#DCE4FF"
                            CornerRadius="10"
                            WidthRequest="38"
                            HeightRequest="34"
                            Padding="0"
                            FontSize="16" />
                    <Label x:Name="ColourCountLabel"
                           Grid.Column="2"
                           Text="4"
                           TextColor="#EEF2FF"
                           FontSize="16"
                           FontAttributes="Bold"
                           WidthRequest="24"
                           HorizontalTextAlignment="Center"
                           VerticalOptions="Center" />
                    <Button x:Name="ColourCountUp"
                            Grid.Column="3"
                            Text="+"
                            Clicked="OnMoreColours"
                            BackgroundColor="#1B2234"
                            TextColor="#DCE4FF"
                            CornerRadius="10"
                            WidthRequest="38"
                            HeightRequest="34"
                            Padding="0"
                            FontSize="16" />
                </Grid>

                <!-- The palette the model was printed with; edits are written into the 3MF -->
                <VerticalStackLayout x:Name="PrintColoursRow"
                                     Spacing="4"
                                     IsVisible="False">
                    <Label Text="Print colours"
                           TextColor="#DCE4FF"
                           FontSize="14" />
                    <Label Text="Tap a colour to name it and match your filament."
                           TextColor="#8C97B5"
                           FontSize="11" />
                    <ScrollView Orientation="Horizontal"
                                HorizontalScrollBarVisibility="Never">
                        <HorizontalStackLayout x:Name="ColourChips"
                                               Spacing="10"
                                               Padding="0,2" />
                    </ScrollView>
                </VerticalStackLayout>

            </VerticalStackLayout>

            </VerticalStackLayout>
          </ScrollView>

            <!-- 3D view -->
            <Border Grid.Row="1"
                    HeightRequest="280"
                    BackgroundColor="#0E1220"
                    Stroke="#242C42"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 16"
                    Padding="0">
                <Grid>
                    <controls:MeshViewer x:Name="Viewer" />

                    <Label x:Name="ViewerHint"
                           Text="The generated model appears here.&#10;Drag to rotate, pinch to zoom."
                           TextColor="#5A6480"
                           FontSize="13"
                           HorizontalTextAlignment="Center"
                           VerticalOptions="Center"
                           HorizontalOptions="Center" />

                    <Label x:Name="StatsLabel"
                           TextColor="#8C97B5"
                           FontSize="11"
                           Margin="12,0,12,10"
                           VerticalOptions="End"
                           IsVisible="False" />
                </Grid>
            </Border>

            <!-- Generating stays on screen while the settings above it scroll -->
            <VerticalStackLayout Grid.Row="2" Spacing="8">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                    <Button x:Name="ColoursButton"
                            Text="Colours"
                            Clicked="OnColoursClicked"
                            IsEnabled="False"
                            BackgroundColor="#2A3350"
                            TextColor="#DCE4FF"
                            CornerRadius="12"
                            HeightRequest="46"
                            FontSize="13" />

                    <Button x:Name="GenerateButton"
                            Grid.Column="1"
                            Text="Generate 3D model"
                            Clicked="OnGenerateClicked"
                            IsEnabled="False"
                            BackgroundColor="#EEF2FF"
                            TextColor="#0B0F1A"
                            FontAttributes="Bold"
                            CornerRadius="12"
                            HeightRequest="46" />
                </Grid>

                <pv:ClaudeProgressBar x:Name="ProgressBar"
                                      Progress="0"
                                      Text="Ready when you are"
                                      IsPercentageShown="True"
                                      IsAnimating="False"
                                      BarThickness="10"
                                      ProgressColor="#6C8CFF"
                                      TrackColor="#1B2234"
                                      ShimmerColor="#B9C8FF" />
            </VerticalStackLayout>

            <!-- Export -->
            <Grid Grid.Row="3" ColumnDefinitions="*,*" ColumnSpacing="10">
                <Button x:Name="Share3mfButton"
                        Text="Share .3mf"
                        Clicked="OnShareThreeMf"
                        IsEnabled="False"
                        BackgroundColor="#2A3350"
                        TextColor="#DCE4FF"
                        CornerRadius="12"
                        HeightRequest="44" />
                <Button x:Name="ShareStlButton"
                        Grid.Column="1"
                        Text="Share .stl"
                        Clicked="OnShareStl"
                        IsEnabled="False"
                        BackgroundColor="#2A3350"
                        TextColor="#DCE4FF"
                        CornerRadius="12"
                        HeightRequest="44" />
            </Grid>
        </Grid>

        <!-- Full-screen editor: crop, or pick an object to keep -->
        <Grid x:Name="EditorPanel"
              IsVisible="False"
              BackgroundColor="#0B0F1A"
              RowDefinitions="Auto,*,Auto,Auto"
              RowSpacing="10"
              Padding="16,14,16,16">

            <VerticalStackLayout Grid.Row="0" Spacing="2">
                <Label x:Name="EditorTitle"
                       Text="Crop the photo"
                       FontSize="22"
                       FontAttributes="Bold"
                       TextColor="#EEF2FF" />
                <Label x:Name="EditorHint"
                       TextColor="#8C97B5"
                       FontSize="12" />
            </VerticalStackLayout>

            <Grid Grid.Row="1">
                <Image x:Name="EditorImage"
                       Aspect="AspectFit" />
                <controls:SelectionOverlay x:Name="Overlay" />
            </Grid>

            <!-- Only for object mode: how strictly the outline follows the photo's colours -->
            <VerticalStackLayout Grid.Row="2"
                                 x:Name="EditorObjectOptions"
                                 Spacing="2"
                                 IsVisible="False">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                    <Label Text="Colour match"
                           TextColor="#8C97B5"
                           FontSize="13"
                           VerticalOptions="Center" />
                    <Slider x:Name="EditorToleranceSlider"
                            Grid.Column="1"
                            Minimum="0.03"
                            Maximum="0.5"
                            Value="0.2"
                            MaximumTrackColor="#2A3350"
                            MinimumTrackColor="#4ADEA9"
                            ThumbColor="#EEF2FF"
                            ValueChanged="OnToleranceChanged"
                            DragStarted="OnToleranceDragStarted"
                            DragCompleted="OnToleranceDragCompleted" />
                    <Label x:Name="EditorToleranceLabel"
                           Grid.Column="2"
                           Text="20%"
                           TextColor="#DCE4FF"
                           FontSize="13"
                           WidthRequest="44"
                           HorizontalTextAlignment="End"
                           VerticalOptions="Center" />
                </Grid>
                <Label x:Name="EditorObjectStatus"
                       Text="Higher matches more of the surrounding background, so the edge hugs the object."
                       TextColor="#8C97B5"
                       FontSize="11" />
            </VerticalStackLayout>

            <Grid Grid.Row="3" ColumnDefinitions="*,*,*" ColumnSpacing="10">
                <Button Text="Redraw"
                        Clicked="OnEditorRedraw"
                        BackgroundColor="#2A3350"
                        TextColor="#DCE4FF"
                        CornerRadius="12"
                        HeightRequest="44"
                        FontSize="13" />
                <Button Grid.Column="1"
                        Text="Cancel"
                        Clicked="OnEditorCancel"
                        BackgroundColor="#1B2234"
                        TextColor="#8C97B5"
                        CornerRadius="12"
                        HeightRequest="44"
                        FontSize="13" />
                <Button x:Name="EditorApplyButton"
                        Grid.Column="2"
                        Text="Apply"
                        Clicked="OnEditorApply"
                        IsEnabled="False"
                        BackgroundColor="#6C8CFF"
                        TextColor="#0B0F1A"
                        FontAttributes="Bold"
                        CornerRadius="12"
                        HeightRequest="44" />
            </Grid>
        </Grid>

        <!-- The print colours, opened from the Colours button so the picker is reachable without scrolling. -->
        <Grid x:Name="PaletteLayer"
              IsVisible="False"
              ZIndex="9"
              BackgroundColor="#E60B0F1A"
              Padding="18">
            <Border BackgroundColor="#161C2C"
                    Stroke="#242C42"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 18"
                    Padding="18"
                    VerticalOptions="Center">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Print colours"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="#EEF2FF" />
                    <Label Text="Tap a colour to match your filament and name it."
                           FontSize="12"
                           TextColor="#8C97B5" />

                    <ScrollView VerticalScrollBarVisibility="Never"
                                MaximumHeightRequest="360">
                        <VerticalStackLayout x:Name="PaletteRows" Spacing="8" />
                    </ScrollView>

                    <Button Text="Done"
                            Clicked="OnPaletteDone"
                            BackgroundColor="#EEF2FF"
                            TextColor="#0B0F1A"
                            FontAttributes="Bold"
                            CornerRadius="12"
                            HeightRequest="44" />
                </VerticalStackLayout>
            </Border>
        </Grid>

        <!-- Modal layer for the colour picker; kept empty until a picker is opened. -->
        <Grid x:Name="ModalLayer" IsVisible="False" ZIndex="10" />

    </Grid>
</ContentPage>
